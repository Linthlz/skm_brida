# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.

# ---------- Server ----------
PORT=3000
APP_URL=http://localhost:3000
# Origin frontend yang boleh mengakses API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
# Pilih salah satu: DATABASE_URL, atau DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/singariset?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=singariset
DB_SSLMODE=disable

# ---------- JWT (wajib) ----------
# Buat string acak panjang, misalnya: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRED=24h
JWT_EXPIRY_MINUTES=60

# ---------- SMTP (kode verifikasi email saat register) ----------
# MAIL_MAILER: smtp = kirim email sungguhan, log = cetak email (termasuk kode verifikasi) ke log server
MAIL_MAILER=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS="no-reply@singariset.local"
MAIL_FROM_NAME="Singa Riset"
# null/kosong/starttls = STARTTLS jika server mendukung, tls/ssl = TLS langsung (port 465)
MAIL_ENCRYPTION=null

# ---------- Seeder akun awal (dijalankan saat server start, dilewati jika kosong) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator BRIDA
SEED_MEDIA_EMAIL=
SEED_MEDIA_PASSWORD=
SEED_MEDIA_NAME=Pengelola Media BRIDA

# ---------- Seeder data demo (HANYA lokal; kosongkan di produksi) ----------
# Jika diisi, data demo dibuat saat server start (dan lewat: go run ./cmd/seed)
# Password untuk semua akun *@demo.singariset.local, minimal 8 karakter
SEED_DEMO_PASSWORD=

# ---------- Docker (docker compose) ----------
# Database PostgreSQL di dalam container; backend di container memakai ini, bukan DB_* di atas.
POSTGRES_USER=singariset
POSTGRES_PASSWORD=
POSTGRES_DB=singariset
# Port di host (ubah jika bentrok)
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=3000

# ---------- SKM (Survei Kepuasan Masyarakat) ----------
# Batas kirim per IP per jam untuk endpoint publik /api/v2/skm/survei dan /kontak
SKM_SURVEI_PER_JAM=20
SKM_KONTAK_PER_JAM=5
# Salt hash IP responden (IP mentah tidak disimpan). Kosong = memakai JWT_SECRET
SKM_IP_SALT=
